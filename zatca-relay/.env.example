# ---------------------------------------------------------------------------
# SA'DA H2O — ZATCA signing relay configuration. Copy to .env and fill in.
# NONE of these secrets ever reach the browser or the Cloudflare Worker bundle.
# ---------------------------------------------------------------------------

# Which ZATCA environment this relay talks to:
#   developer-portal = sandbox (free, for first integration + testing)
#   simulation       = pre-production (mirrors production, for final validation)
#   core             = PRODUCTION (live invoices — only after passing compliance)
ZATCA_ENV=developer-portal

# A shared secret the caller (Worker / dashboard proxy) must send in the
# `x-relay-key` header. Generate a long random string. This gates who may ask
# the relay to sign + report invoices.
RELAY_API_KEY=change-me-to-a-long-random-string

# Port the relay listens on (put it behind TLS / a reverse proxy, like the SMS relay).
PORT=8791

# EGS (E-invoice Generation Solution) unit identity — these go into the CSR.
# They must match SA'DA's ZATCA registration. See README "Onboarding".
EGS_COMMON_NAME=SADA-H2O-EGS-001
EGS_SERIAL_NUMBER=1-SADA|2-H2O|3-0001
EGS_ORG_IDENTIFIER=                # 15-digit VAT number
EGS_ORG_UNIT_NAME=                 # for standard invoices: VAT group / branch; else the VAT number
EGS_ORG_NAME=SA'DA H2O Water Purifiers
EGS_COUNTRY=SA
EGS_INVOICE_TYPE=0100              # 1=standard,0=simplified per position; 0100 = simplified only
EGS_LOCATION=Jubail
EGS_INDUSTRY=Water purification

# Onboarding OTP — generated in the ZATCA Fatoora portal, valid ~1 hour.
# Only needed while running `npm run onboard`. Do NOT commit a real value.
ZATCA_OTP=

# Paths where onboarding writes/reads the key + certificates (keep OUTSIDE web root).
CERT_DIR=./secrets
