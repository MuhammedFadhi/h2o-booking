# SA'DA H2O — ZATCA signing relay settings (created by deploy/install.sh).
# Keep this file private (chmod 600). Restart after editing:
#     pm2 restart zatca-relay --update-env

# Which ZATCA platform: developer-portal (sandbox) | simulation | core (PRODUCTION).
# Start with simulation. Only switch to core after simulation works end to end;
# each environment needs its own onboarding (move secrets/ aside first).
ZATCA_ENV=simulation

# Shared secret the Cloudflare Worker sends in the x-relay-key header.
# install.sh generates it; paste the same value into the Worker secret ZATCA_RELAY_KEY.
RELAY_API_KEY=

# Listen on localhost only — nginx in front provides HTTPS for zatca.sadawater.com.
HOST=127.0.0.1
PORT=8791

# Private key + ZATCA certificates are written here by onboarding. BACK IT UP.
CERT_DIR=/root/zatca-relay/secrets

# ---- EGS unit (goes into the certificate request) ----------------------------
# SA'DA invoices as a member of a VAT GROUP: ZATCA wants the 10-digit TIN of the
# member company Saadat Alarab Company For Trading (CR 7028780372). It is not on
# the VAT or CR certificate — get it from the ZATCA portal or the accountant.
EGS_ORG_UNIT_NAME=

# Filled in from the dashboard's ZATCA Seller Details when left blank:
EGS_ORG_IDENTIFIER=311272145800003
EGS_ORG_NAME=Saadat Alarab Company For Trading
EGS_LOCATION=Al Khobar

EGS_COMMON_NAME=SADA-H2O-EGS-001
EGS_SERIAL_NUMBER=1-SADA|2-H2O|3-0001
EGS_COUNTRY=SA
# 0100 = simplified (B2C) invoices only. Use 1100 if you will also issue standard
# (B2B) invoices — decide BEFORE onboarding, it is fixed in the certificate.
EGS_INVOICE_TYPE=0100
EGS_INDUSTRY=Water purification

# Only for `npm run onboard` on the server; the dashboard's Onboard button sends it instead.
ZATCA_OTP=
